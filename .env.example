# Connection strings do Neon.
#
# .env.local → branch principal (produção). Gerado pela Vercel:
#   vercel env pull .env.local
#
# .env.development.local → branch "test", usada pelo `yarn dev`,
# `yarn db:migrate` e `yarn user:create`. Crie à mão com a connection string
# da branch test (Neon → Branches → test → Connect).
#
# Para aplicar migrations em produção: yarn db:migrate:prod
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Google Maps (autocomplete de endereço no perfil). Chave pública: restrinja no
# Google Cloud por HTTP referrer e libere só "Maps JavaScript API" e
# "Places API (New)". Sem ela, o campo de endereço funciona sem sugestões.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyBTaxZTiUFUWf14DWPKAI0M5bb8efTzENg"
